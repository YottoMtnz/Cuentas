$mark=@'

'@
try{
 Write-Host 'Cuentas - creador de la app Android' -ForegroundColor Green
 Write-Host 'La primera vez descarga cerca de 1 GB, necesita unos 3 GB libres en el disco y tarda de 10 a 20 minutos. No cierres esta ventana.'
 New-Item -ItemType Directory -Force -Path $tools,$sdk|Out-Null
 $dd="$base\gradle\wrapper\dists"
 if(Test-Path $dd){Get-ChildItem $dd -Directory -Filter '*-all' -ErrorAction SilentlyContinue|Remove-Item -Recurse -Force -ErrorAction SilentlyContinue}
 Need-Space 3

 if(Test-Path "$tools\jdk\bin\java.exe"){Step 1 'Java ya esta listo'}else{
  Step 1 'Descargando Java 17'
  Get-File 'https://api.adoptium.net/v3/binary/latest/17/ga/windows/x64/jdk/hotspot/normal/eclipse' "$tools\jdk.zip"
  Unzip "$tools\jdk.zip" "$tools\jdk_x"
  Lift "$tools\jdk_x" "$tools\jdk"
  Remove-Item "$tools\jdk.zip" -Force
 }

 if(Test-Path "$tools\node\node.exe"){Step 2 'Node.js ya esta listo'}else{
  Step 2 'Descargando Node.js'
  $v=Get-NodeVersion
  Get-File @("https://nodejs.org/dist/$v/node-$v-win-x64.zip","https://npmmirror.com/mirrors/node/$v/node-$v-win-x64.zip") "$tools\node.zip"
  Unzip "$tools\node.zip" "$tools\node_x"
  Lift "$tools\node_x" "$tools\node"
  Remove-Item "$tools\node.zip" -Force
 }

 $n='11076708'
 $pin="$sdk\cmdline-tools\version.txt"
 $have=''
 if(Test-Path $pin){$have=(Get-Content $pin -Raw).Trim()}
 if((Test-Path "$sdk\cmdline-tools\latest\bin\sdkmanager.bat") -and ($have -eq $n)){Step 3 'Herramientas de Android ya estan listas'}else{
  Step 3 'Descargando herramientas de Android (version fija 11.0)'
  if(Test-Path "$sdk\cmdline-tools"){Remove-Item "$sdk\cmdline-tools" -Recurse -Force}
  Get-File "https://dl.google.com/android/repository/commandlinetools-win-${n}_latest.zip" "$tools\cmd.zip"
  Unzip "$tools\cmd.zip" "$tools\cmd_x"
  New-Item -ItemType Directory -Force -Path "$sdk\cmdline-tools"|Out-Null
  Move-Item "$tools\cmd_x\cmdline-tools" "$sdk\cmdline-tools\latest"
  Remove-Item "$tools\cmd_x","$tools\cmd.zip" -Recurse -Force
  Set-Content $pin $n -Encoding ASCII
 }

 $env:JAVA_HOME="$tools\jdk"
 $env:ANDROID_HOME=$sdk
 $env:ANDROID_SDK_ROOT=$sdk
 $env:GRADLE_USER_HOME="$base\gradle"
 $env:CI='true'
 $env:PATH="$tools\node;$tools\jdk\bin;$sdk\cmdline-tools\latest\bin;$sdk\platform-tools;$env:PATH"

 Step 4 'Instalando componentes de Android'
 $yes=("y`n"*40)
 $yes|& "$sdk\cmdline-tools\latest\bin\sdkmanager.bat" --sdk_root="$sdk" --licenses|Out-Null
 & "$sdk\cmdline-tools\latest\bin\sdkmanager.bat" --sdk_root="$sdk" 'platform-tools' 'platforms;android-34' 'build-tools;34.0.0'
 Ok
 if(-not (Test-Path "$sdk\platforms\android-34")){throw 'No se instalo Android 34. Borra la carpeta C:\CuentasApp\tools\android y vuelve a ejecutar el .bat.'}
 if(-not (Test-Path "$sdk\build-tools\34.0.0")){throw 'No se instalaron las herramientas de compilacion. Borra la carpeta C:\CuentasApp\tools\android y vuelve a ejecutar el .bat.'}

 Step 5 'Preparando el proyecto'
 if(Test-Path $app){Remove-Item $app -Recurse -Force}
 New-Item -ItemType Directory -Force -Path "$app\www"|Out-Null
 $htmlText=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b64))
 $gurl='';$gcod=''
 $cf=Join-Path $here 'google-config.txt'
 if(Test-Path $cf){foreach($ln in (Get-Content -LiteralPath $cf -Encoding UTF8)){if($ln -match '^\s*URL\s*=\s*(\S+)\s*$'){$gurl=$Matches[1]}elseif($ln -match '^\s*CODIGO\s*=\s*(\S+)\s*$'){$gcod=$Matches[1]}}}
 if($gurl -and ($gurl -notmatch '^https://script\.google\.com/(a/macros/[^/]+/|macros/)s/[A-Za-z0-9_-]+/exec$')){throw 'La URL de google-config.txt no es valida. Debe ser la URL de la aplicacion web de Google (termina en /exec).'}
 if($gcod -and ($gcod -notmatch '^[A-Za-z0-9._-]{8,64}$')){throw 'El CODIGO de google-config.txt debe tener de 8 a 64 caracteres: letras, numeros, punto, guion o guion bajo.'}
 if($gurl){$htmlText=$htmlText.Replace("const GS_URL='',GS_CODE='';","const GS_URL='$gurl',GS_CODE='$gcod';");Write-Host 'Google Sheets: la app usara la URL de google-config.txt (con usuarios y contrasenas).' -ForegroundColor Green}else{Write-Host 'Aviso: no hay URL en google-config.txt; la app guardara los datos solo en el telefono.' -ForegroundColor Yellow}
 [IO.File]::WriteAllBytes("$app\www\index.html",[Text.Encoding]::UTF8.GetBytes($htmlText))
 Set-Location $app
 '{"name":"cuentas","version":"1.0.0","private":true}'|Set-Content package.json -Encoding ASCII
 & "$tools\node\npm.cmd" install @capacitor/core@6 @capacitor/cli@6 @capacitor/android@6 @capacitor/filesystem@6 @capacitor/share@6 --no-audit --no-fund --loglevel=error
 Ok
 '{"appId":"com.cuentas.app","appName":"Cuentas","webDir":"www","backgroundColor":"#0b3d33","server":{"androidScheme":"https"}}'|Set-Content capacitor.config.json -Encoding ASCII
 & "$tools\node\npx.cmd" cap telemetry off
 & "$tools\node\npx.cmd" cap add android
 Ok

 $res="$app\android\app\src\main\res"
 $u8=New-Object Text.UTF8Encoding($false)
 Get-ChildItem $res -Recurse -File -Include 'ic_launcher.*','ic_launcher_round.*' -ErrorAction SilentlyContinue|Remove-Item -Force
 foreach($ln in ($icons -split '\r?\n')){
  if($ln.Trim()){
   $q=$ln.Trim().Split('|')
   $dr="$res\$($q[0])"
   New-Item -ItemType Directory -Force -Path $dr|Out-Null
   [IO.File]::WriteAllBytes("$dr\$($q[1]).png",[Convert]::FromBase64String($q[2]))
  }
 }
 $v26="$res\drawable-v26";$any="$res\mipmap-anydpi-v26"
 New-Item -ItemType Directory -Force -Path $v26,$any|Out-Null
 [IO.File]::WriteAllText("$v26\cuentas_icon_bg.xml",@'
