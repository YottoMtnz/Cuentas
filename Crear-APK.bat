@echo off
title Cuentas - Crear app Android
set "BATDIR=%~dp0"
set "BATFILE=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText($env:BATFILE);$i=$t.LastIndexOf('#'+'PS1'+'#');iex ($t.Substring($i+5))"
echo.
pause
exit /b
#PS1#
$ErrorActionPreference='Stop'
$ProgressPreference='SilentlyContinue'
[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12
Add-Type -AssemblyName System.IO.Compression.FileSystem
$here=$env:BATDIR
$base='C:\CuentasApp'
if($env:CUENTAS_BASE){$base=$env:CUENTAS_BASE}
$tools="$base\tools"
$sdk="$tools\android"
$app="$base\app"
function Step($n,$t){Write-Host ''; Write-Host "[$n/7] $t" -ForegroundColor Cyan}
$ua='Mozilla/5.0 (Windows NT 10.0; Win64; x64) CuentasBuilder/2'
function Get-File($u,$f){
 $last=''
 foreach($url in @($u)){
  for($i=1;$i -le 3;$i++){
   try{Invoke-WebRequest -UseBasicParsing -UserAgent $ua -Uri $url -OutFile $f;return}
   catch{$last=$url+' -> '+$_.Exception.Message;Start-Sleep -Seconds 2}
  }
 }
 throw ('No pude descargar: '+$last)
}
function Get-NodeVersion{
 $v=$null
 try{
  $txt=[string](Invoke-WebRequest -UseBasicParsing -UserAgent $ua -Uri 'https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt').Content
  $m=[regex]::Match($txt,'node-(v22\.\d+\.\d+)-win-x64\.zip')
  if($m.Success){$v=$m.Groups[1].Value}
 }catch{}
 if(-not $v){$v='v22.11.0'}
 return $v
}
function Unzip($z,$d){if(Test-Path $d){Remove-Item $d -Recurse -Force};[IO.Compression.ZipFile]::ExtractToDirectory($z,$d)}
function Lift($tmp,$dest){$d=Get-ChildItem $tmp -Directory|Select-Object -First 1;Move-Item $d.FullName $dest;Remove-Item $tmp -Recurse -Force}
function Ok{if($LASTEXITCODE -ne 0){throw "Un paso fallo (codigo $LASTEXITCODE). Revisa los mensajes de arriba."}}
function Free-GB($p){$r=[IO.Path]::GetPathRoot($p);return [math]::Round(([IO.DriveInfo]$r).AvailableFreeSpace/1GB,1)}
function Need-Space($gb){
 $f=Free-GB $base
 if($f -lt $gb){throw ('Poco espacio en el disco: hay '+$f+' GB libres en '+[IO.Path]::GetPathRoot($base)+' y hacen falta unos '+$gb+' GB. Libera espacio (vacia la Papelera, usa el Liberador de espacio en disco de Windows, borra descargas viejas) y vuelve a ejecutar el .bat. Si tienes otro disco con espacio, abre una ventana de cmd, escribe: set CUENTAS_BASE=D:\CuentasApp   luego ve a la carpeta del .bat y ejecutalo desde esa misma ventana.')}
}
